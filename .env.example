# Local development environment. Copy to `.env` and fill in.
#
# In PRODUCTION these are NOT read from a file — Firebase App Hosting injects
# them from apphosting.yaml, with secret values held in Google Secret Manager:
#   firebase apphosting:secrets:set RESEND_API_KEY --force
#   firebase apphosting:secrets:set ENGAGEMENT_ADMIN_TOKEN --force
#   firebase apphosting:secrets:set ENGAGEMENT_IP_SALT --force

# Email delivery (Resend). RESEND_FROM must be on a domain verified in Resend.
RESEND_API_KEY="re_xxxxxxxxx"
RESEND_FROM="Hotel Royal Fort <enquiries@hotelroyalfort.in>"
ENQUIRY_TO_EMAIL="gmroyalfort@gmail.com"

# WhatsApp is click-to-chat (wa.me) links only — no server-side API, no keys.

# Engagement analytics — stored in Firestore (collection: engagementVisits).
# View at /admin/engagement?token=... or export /api/engagement/visits.csv?token=...
ENGAGEMENT_ADMIN_TOKEN="change-this-long-random-token"
ENGAGEMENT_IP_SALT="change-this-random-salt"

# Firestore access locally needs Application Default Credentials:
#   gcloud auth application-default login
# Without them the site still serves; only engagement endpoints return 503.
