# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Email delivery for website enquiries.
# For Gmail, use an app password rather than your normal account password.
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="465"
SMTP_SECURE="true"
SMTP_USER="your-sender-email@gmail.com"
SMTP_PASS="your-app-password"
SMTP_FROM="your-sender-email@gmail.com"
ENQUIRY_TO_EMAIL="gmroyalfort@gmail.com"

# Engagement analytics.
# Visit rows are stored in Firestore (collection: engagementVisits).
# View at /admin/engagement?token=... or download /api/engagement/visits.csv?token=...
ENGAGEMENT_ADMIN_TOKEN="change-this-long-random-token"
ENGAGEMENT_IP_SALT="change-this-random-salt"

# NOTE: In production these values are NOT read from a .env file. App Hosting
# injects them from apphosting.yaml, with secrets held in Secret Manager:
#   firebase apphosting:secrets:set SMTP_USER
#   firebase apphosting:secrets:set SMTP_PASS
#   firebase apphosting:secrets:set ENGAGEMENT_ADMIN_TOKEN
#   firebase apphosting:secrets:set ENGAGEMENT_IP_SALT
# This file is only for running the server locally.
#
# Firestore access locally needs Application Default Credentials:
#   gcloud auth application-default login
# Without them the site still serves; only engagement endpoints return 503.
