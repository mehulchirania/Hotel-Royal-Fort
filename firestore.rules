rules_version = '2';

// Engagement rows are written only by the Express server via the Admin SDK,
// which bypasses these rules entirely. No browser should ever read or write
// them directly — the data includes hashed IPs and coarse geolocation.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
